generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql" // ganti "postgresql" kalau pakai Postgres
  url      = env("DATABASE_URL")
}

// ==== AUTH (pola NextAuth) ====

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String? // untuk credentials login
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  weddingPlan   WeddingPlan? @relation("Owner")
  collaborations CollaboratorInvite[] @relation("InvitedUser")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==== CORE DOMAIN ====

model WeddingPlan {
  id            String   @id @default(cuid())
  ownerId       String   @unique
  owner         User     @relation("Owner", fields: [ownerId], references: [id])

  partnerName   String?
  weddingDate   DateTime?
  venueCity     String?
  concept       String? // intimate / adat / modern
  budgetTotal   Decimal? @db.Decimal(14, 2)
  onboardingDone Boolean @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  roadmapTasks  RoadmapTask[]
  budgetItems   BudgetItem[]
  vendors       Vendor[]
  documents     Document[]
  collaborators CollaboratorInvite[]
}

model RoadmapTask {
  id            String   @id @default(cuid())
  weddingPlanId String
  weddingPlan   WeddingPlan @relation(fields: [weddingPlanId], references: [id], onDelete: Cascade)

  title         String
  phase         String   // contoh: "H-12", "H-6", "H-3", "H-1"
  dueDate       DateTime?
  isDone        Boolean  @default(false)
  notes         String?  @db.Text

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BudgetItem {
  id            String   @id @default(cuid())
  weddingPlanId String
  weddingPlan   WeddingPlan @relation(fields: [weddingPlanId], references: [id], onDelete: Cascade)

  category      String   // venue, catering, MUA, dekorasi, dokumentasi, dll
  label         String
  estimatedCost Decimal  @db.Decimal(14, 2)
  actualCost    Decimal? @db.Decimal(14, 2)
  isPaid        Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Vendor {
  id            String   @id @default(cuid())
  weddingPlanId String
  weddingPlan   WeddingPlan @relation(fields: [weddingPlanId], references: [id], onDelete: Cascade)

  name          String
  category      String   // catering, MUA, fotografer, dekorasi, MC, dll
  contact       String?
  status        String   @default("prospect") // prospect / negotiating / booked
  dpAmount      Decimal? @db.Decimal(14, 2)
  notes         String?  @db.Text

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Document {
  id            String   @id @default(cuid())
  weddingPlanId String
  weddingPlan   WeddingPlan @relation(fields: [weddingPlanId], references: [id], onDelete: Cascade)

  type          String   // KTP, KK, akta lahir, N1-N4, surat pengantar, dll
  fileUrl       String?
  status        String   @default("pending") // pending / uploaded / verified
  note          String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CollaboratorInvite {
  id            String   @id @default(cuid())
  weddingPlanId String
  weddingPlan   WeddingPlan @relation(fields: [weddingPlanId], references: [id], onDelete: Cascade)

  invitedUserId String?
  invitedUser   User?    @relation("InvitedUser", fields: [invitedUserId], references: [id])
  invitedEmail  String
  role          String   @default("helper") // helper / WO / keluarga
  status        String   @default("pending") // pending / accepted

  createdAt     DateTime @default(now())
}
